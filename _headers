/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

/konyvelo.html
  Cache-Control: no-store
  Referrer-Policy: no-referrer

/konyvelo
  Cache-Control: no-store
  Referrer-Policy: no-referrer

/fiokom.html
  Cache-Control: no-store
  Referrer-Policy: no-referrer

/fiokom
  Cache-Control: no-store
  Referrer-Policy: no-referrer

/megerosites.html
  Cache-Control: no-store
  Referrer-Policy: no-referrer

/megerosites
  Cache-Control: no-store
  Referrer-Policy: no-referrer

# Images and films keep their names when they change only rarely: a week in the browser is safe.
/images/*
  Cache-Control: public, max-age=604800

/videos/*
  Cache-Control: public, max-age=604800

# The version is in the file name, so it never changes under the same address.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
